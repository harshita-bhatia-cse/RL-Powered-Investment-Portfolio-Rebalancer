# FinRL Trading - Environment Configuration Template
# =================================================
#
# Copy this file to .env and fill in your actual values
# Never commit your .env file to version control!
#
# Optional legacy integration: Alpaca credentials for the CLI trading path.
# They are not required for the India-focused portfolio API or dashboard.
# Optional: Data source APIs (FMP > WRDS > Yahoo priority)
#

# =================================================
# APPLICATION SETTINGS
# =================================================

# Application environment
ENVIRONMENT=development
APP_NAME=FinRL Trading
VERSION=2.0.0

# =================================================
# ALPACA API SETTINGS (Required for Trading)
# =================================================

# Get these from: https://alpaca.markets/
APCA_API_KEY=your_alpaca_api_key_here
APCA_API_SECRET=your_alpaca_secret_key_here
APCA_BASE_URL=https://paper-api.alpaca.markets
APCA_USE_PAPER_TRADING=true
# =================================================
# ALPACA API SETTINGS Multi-account  (Required for Trading)
# =================================================
# list your account name (nick name) 
APCA_ACCOUNTS=paper1,paper2


#   general （rollback）
APCA_BASE_URL=https://paper-api.alpaca.markets
APCA_USE_PAPER_TRADING=true

# Account1 paper1


APCA_PAPER1_API_KEY=your_alpaca_api_key_here
APCA_PAPER1_API_SECRET=your_alpaca_secret_key_here
APCA_PAPER1_BASE_URL=https://paper-api.alpaca.markets/


# account2 paper2
APCA_PAPER2_API_KEY=your_alpaca_api_key_here
APCA_PAPER2_API_SECRET=your_alpaca_secret_key_here
APCA_PAPER2_BASE_URL=https://paper-api.alpaca.markets

# =================================================
# DATA SOURCE SETTINGS (Optional, prioritized)
# =================================================

# FMP API Key (Recommended for high-quality data)
FMP_API_KEY=your_fmp_api_key_here

INDIA_DATA_PROVIDER=yahoo-finance-yfinance
INDIA_DATA_SYMBOLS=RELIANCE.NS,TCS.NS
INDIA_DATA_INTERVAL=1d
INDIA_DATA_START_DATE=
INDIA_DATA_END_DATE=
INDIA_DATA_BACKFILL=false
INDIA_USE_STOCK_UNIVERSE=false
INDIA_STOCK_UNIVERSE_SECTOR=
# Authenticated India market-data provider (Alpha Vantage).
# Use only if you have an active subscription/plan for the required endpoints.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
INDIA_MARKET_DATA_BASE_URL=https://www.alphavantage.co/query



# =================================================
# LLM SETTINGS
# =================================================

GEMINI_API_KEY=your_openai_key
GEMINI_MODEL=gemini_model



# =================================================
# DATABASE SETTINGS
# =================================================

# Separate authenticated portfolio database. Defaults to SQLite; PostgreSQL
# requires installing the optional database extra: pip install -e ".[database]".
PORTFOLIO_DATABASE_URL=sqlite:///./data/portfolio_platform.db

# Independent EOD price storage; does not use or migrate the research DataStore.
MARKET_DATA_DATABASE_URL=sqlite:///./data/market_data.db
# Maximum allowed elapsed calendar-day age for a permitted EOD price.
MARKET_DATA_MAX_AGE_DAYS=4

# Required before issuing or validating login tokens. Generate locally with
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Put the generated value here in your private .env file; never commit it.
AUTH_JWT_SECRET=

# Database connection (SQLite by default)
DB_URL=sqlite:///finrl_trading.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# =================================================
# DATA MANAGEMENT SETTINGS
# =================================================

# Data directories
DATA_BASE_DIR=./data
DATA_CACHE_DIR=./data/cache
DATA_PROCESSED_DIR=./data/processed
DATA_RAW_DIR=./data/raw

# Cache settings
DATA_CACHE_TTL_HOURS=24
DATA_MAX_CACHE_SIZE_MB=1000

# =================================================
# STRATEGY SETTINGS
# =================================================

# Rebalancing frequency (Q: quarterly, M: monthly, W: weekly)
STRATEGY_DEFAULT_REBALANCE_FREQ=Q

# Risk limits
STRATEGY_MAX_WEIGHT_PER_STOCK=0.1
STRATEGY_MAX_SECTOR_WEIGHT=0.3
STRATEGY_MAX_TURNOVER=0.5
STRATEGY_RISK_FREE_RATE=0.02

# Benchmark tickers
STRATEGY_BENCHMARK_TICKERS=["SPY", "QQQ"]

# =================================================
# TRADING SETTINGS
# =================================================

# Order limits
TRADING_MAX_ORDER_VALUE=100000.0
TRADING_MAX_PORTFOLIO_TURNOVER=0.5
TRADING_MIN_ORDER_SIZE=100.0

# Risk management
TRADING_RISK_CHECKS_ENABLED=true
TRADING_EXECUTION_TIMEOUT=300

# Order logging
TRADING_LOG_ORDERS=true
TRADING_ORDER_LOG_PATH=./logs/orders

# =================================================
# WEB INTERFACE SETTINGS
# =================================================

# Streamlit web app
WEB_HOST=0.0.0.0
WEB_PORT=8501
WEB_DEBUG=false
WEB_THEME=light

# =================================================
# LOGGING SETTINGS
# =================================================

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_PATH=./logs/finrl_trading.log
LOG_MAX_FILE_SIZE=10485760
LOG_BACKUP_COUNT=5

# =================================================
# DEVELOPMENT/DEBUG SETTINGS
# =================================================

# Additional debug settings (development only)
DEBUG_MODE=false
VERBOSE_LOGGING=false

# =================================================
# SETUP INSTRUCTIONS
# =================================================
#
# 1. Alpaca API (Optional; legacy CLI trading integration only):
#    - Sign up at https://alpaca.markets/
#    - Create API keys in dashboard
#    - Use paper trading for testing
#    - Not required for the India-focused portfolio API or dashboard
#
# 2. Data Sources (Optional but recommended):
#    - FMP: https://financialmodelingprep.com/ (best quality)
#    - WRDS: https://wrds-www.wharton.upenn.edu/ (academic)
#    - Yahoo: Free but rate-limited
#
# 3. After filling in values:
#    - Save as .env (not .env.example)
#    - Restart any running applications
#    - Check configuration without displaying credentials:
#      python -c "from src.config.settings import get_config; print('configured' if get_config().alpaca.api_key else 'not configured')"
#
# =================================================
